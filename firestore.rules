rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // Products catalog: open read so retailers and visitors see the products
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Manufacturers
    match /manufacturers/{manufacturerId} {
      allow read: if true;
      allow write: if true;
    }

    // Retailers
    match /retailers/{retailerId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
